      "question": null, "round": null, "mc": { "status": "idle" }, "openGate": null, "revealedAnswer": null } } },
    { "delayMs": 300, "send": { "type": "act.started", "gate": { "id": "g-0", "timeoutMs": 8000 }, "data": {
      "act": 2, "title": "Act 2 · Buzzer", "questionCount": 4,

    { "delayMs": 0, "send": { "type": "answer.revealed", "gate": { "id": "g-0", "timeoutMs": 6000 }, "data": {
      "questionId": "q-av-02", "answer": "Danse Macabre", "answerText": "Saint-Saëns, Danse Macabre",

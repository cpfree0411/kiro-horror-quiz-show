      "seats": [
        { "seat": 0, "status": "occupied", "player": { "id": "p-mina", "name": "Mina", "fanType": "sack", "score": 30, "rank": 1, "connected": true } },
        { "seat": 1, "status": "occupied", "player": { "id": "p-junho", "name": "Junho", "fanType": "bolt", "score": 20, "rank": 2, "connected": true } },
        { "seat": 2, "status": "occupied", "player": { "id": "p-ray", "name": "Ray", "fanType": "tophat_skull", "score": 10, "rank": 3, "connected": true } }

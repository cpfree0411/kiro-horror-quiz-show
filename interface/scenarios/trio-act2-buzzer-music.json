    { "delayMs": 0, "send": { "type": "av.play", "data": { "assetId": "a-3f9c1d2e7b40", "level": 1, "startSec": 0, "endSec": 16 } } },
    { "delayMs": 0, "await": "stage.media_ended", "timeoutMs": 20000, "note": "Played to the end (reason=ended)" },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.open", "deadline": 1761300350000 } } },
    { "delayMs": 1200, "send": { "type": "buzzer.pressed", "data": { "seat": 0, "mediaInterrupted": false, "mcInterrupted": false } } },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.answering", "deadline": 1761300362000 } } },
    { "delayMs": 2000, "send": { "type": "buzzer.answer_heard", "data": { "seat": 0, "text": "Danse Macabre" } } },

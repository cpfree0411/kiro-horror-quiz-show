    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.revealing_answer", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "answer.revealed", "gate": { "id": "g-0", "timeoutMs": 5000 }, "data": {
      "questionId": "q-bz-01", "answer": "Mirror", "answerText": "The midnight mirror",

{
  "$schema": "../stage-protocol.schema.json#/$defs/scenario",
  "name": "trio-act2-buzzer-music",
  "title": "Trio act 2: early buzz while reading, wrong → full text after reading → correct / buzz during the music question → hint → correct",
  "description": "A buzzer question's text first arrives in question.text_revealed, after the reading ends. If someone buzzes during music, the stage stops the music at once and sends stage.media_ended(interrupted); only then does the engine open the answer mic.",

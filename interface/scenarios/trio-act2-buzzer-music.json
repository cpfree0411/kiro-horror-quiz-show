    { "delayMs": 0, "send": { "type": "mc.status", "data": { "status": "speaking" } }, "note": "MC: Let's have a listen" },
    { "delayMs": 2200, "send": { "type": "mc.status", "data": { "status": "idle" } }, "note": "After the MC voice has actually finished playing. The engine keeps the mic closed" },
    { "delayMs": 100, "send": { "type": "phase.changed", "data": { "phase": "buzzer.media", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "buzzer.armed", "data": { "questionId": "q-av-02" } } },
    { "delayMs": 0, "send": { "type": "av.play", "data": { "assetId": "a-3f9c1d2e7b40", "level": 0, "startSec": 12, "endSec": 20 } } },
    { "delayMs": 4300, "send": { "type": "buzzer.pressed", "data": { "seat": 1, "mediaInterrupted": true, "mcInterrupted": false } }, "note": "The stage stops the music at once" },
    { "delayMs": 0, "await": "stage.media_ended", "timeoutMs": 800, "note": "The answer mic opens only after reason=interrupted is confirmed" },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.answering", "deadline": 1761300312000 } } },
    { "delayMs": 300, "send": { "type": "mc.status", "data": { "status": "listening" } } },
    { "delayMs": 2000, "send": { "type": "buzzer.answer_heard", "data": { "seat": 1, "text": "Moonlight Sonata" } } },
    { "delayMs": 300, "send": { "type": "phase.changed", "data": { "phase": "buzzer.judging", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "buzzer.judged", "gate": { "id": "g-0", "timeoutMs": 5000 }, "data": { "seat": 1, "correct": false, "lockedOut": [1] } } },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.open", "deadline": 1761300322000 } } },
    { "delayMs": 6000, "send": { "type": "phase.changed", "data": { "phase": "buzzer.hint", "deadline": null } }, "note": "Nobody left gets it → hint" },
    { "delayMs": 0, "send": { "type": "av.hint", "gate": { "id": "g-0", "timeoutMs": 5000 }, "data": { "level": 1, "media": { "assetId": "a-3f9c1d2e7b40", "mediaType": "audio" } } }, "note": "The gramophone arm swings back toward the start. Another try" },
    { "delayMs": 0, "send": { "type": "mc.status", "data": { "status": "speaking" } } },
    { "delayMs": 2000, "send": { "type": "mc.status", "data": { "status": "idle" } } },
    { "delayMs": 100, "send": { "type": "phase.changed", "data": { "phase": "buzzer.media", "deadline": null } } },

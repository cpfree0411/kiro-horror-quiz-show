    { "delayMs": 0, "await": "stage.media_ready", "timeoutMs": 10000 },

    { "label": "buzzer-q" },
    { "delayMs": 200, "send": { "type": "phase.changed", "data": { "phase": "buzzer.presenting", "deadline": null } } },
    { "delayMs": 100, "send": { "type": "question.presented", "gate": { "id": "g-0", "timeoutMs": 5000 }, "data": { "question": {
      "id": "q-bz-01", "kind": "buzzer", "number": 4, "act": 2, "indexInAct": 1, "category": "Midnight Superstitions",
      "text": null, "textHidden": true, "choices": null, "media": null, "hintLevel": 0, "maxHintLevel": 0 } } }, "note": "The info board shows only the category and 'listen and answer'" },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.reading", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "buzzer.armed", "data": { "questionId": "q-bz-01" } }, "note": "Buzzing is allowed while the question is read" },
    { "delayMs": 0, "send": { "type": "mc.status", "data": { "status": "speaking" } } },
    { "delayMs": 2100, "send": { "type": "buzzer.pressed", "data": { "seat": 2, "mediaInterrupted": false, "mcInterrupted": true } }, "note": "Instantly: MC voice cut + spotlight on Ray + BUZZ!" },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.answering", "deadline": 1761300240000 } } },
    { "delayMs": 300, "send": { "type": "mc.status", "data": { "status": "listening" } } },
    { "delayMs": 2600, "send": { "type": "buzzer.answer_heard", "data": { "seat": 2, "text": "Pillow" } } },
    { "delayMs": 300, "send": { "type": "phase.changed", "data": { "phase": "buzzer.judging", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "buzzer.judged", "gate": { "id": "g-0", "timeoutMs": 5000 }, "data": { "seat": 2, "correct": false, "lockedOut": [2] } } },
    { "delayMs": 0, "send": { "type": "phase.changed", "data": { "phase": "buzzer.reading", "deadline": null } } },
    { "delayMs": 0, "send": { "type": "mc.status", "data": { "status": "speaking" } }, "note": "The MC reads the rest of the question" },
    { "delayMs": 3400, "send": { "type": "mc.status", "data": { "status": "idle" } } },
    { "delayMs": 0, "send": { "type": "question.text_revealed", "data": { "questionId": "q-bz-01", "text": "At midnight, what should you never look into before bed?" } }, "note": "Text revealed only after the reading ends" },
